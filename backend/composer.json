{
  "name": "voak/health-care-backend",
  "description": "Voak Health Care — Enterprise B2B Healthcare Operations Platform Backend",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2 || ^8.3",
    "ext-pdo": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Voak\\Health\\": "src/",
      "Voak\\Health\\Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Voak\\Health\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run_tests.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
