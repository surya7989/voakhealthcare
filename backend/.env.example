# Voak Health Care — Corporate B2B Healthcare Services Platform
# Environment Configuration Template (Placeholder only — zero secrets)
# Copy to .env for local development

# Application Configuration
APP_NAME="Voak Health Care API"
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:PLACEHOLDER_DEV_KEY_REPLACE_WITH_SECURE_32_BYTE_SECRET_IN_PROD==
AUTH_SIGNING_KEY=base64:PLACEHOLDER_AUTH_SIGNING_KEY_32_BYTES_MINIMUM_REQUIRED==
MFA_ENCRYPTION_KEY=base64:PLACEHOLDER_MFA_ENCRYPTION_KEY_32_BYTES_MINIMUM_REQUIRED==
CSRF_SIGNING_KEY=base64:PLACEHOLDER_CSRF_SIGNING_KEY_32_BYTES_MINIMUM_REQUIRED==
APP_URL=http://localhost:8080

# Database Configuration (MySQL 8.x / InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voak_healthcare
DB_USERNAME=voak_db_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
DB_CHARSET=utf8mb4

# CORS Security Configuration (Comma-separated allowed origins; NO wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:4173

# Logging & Storage Configuration
LOG_CHANNEL=daily
LOG_LEVEL=debug
STORAGE_PATH=storage
